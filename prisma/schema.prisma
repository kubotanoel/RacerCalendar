generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  FORMULA
  SPORTSCAR
  STOCK_CAR
  MOTORCYCLE
  RALLY
  OTHER
}

model Series {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  category       Category
  /** Ingestion source tag, e.g. manual, json_import */
  ingestSource   String    @default("manual")
  dataSourceUrl  String?
  licenseNotes   String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  events         Event[]
}

model Event {
  id             String    @id @default(cuid())
  seriesId       String
  series         Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  venueName      String
  timezone       String
  startDate      DateTime
  endDate        DateTime?
  ingestSource   String    @default("manual")
  dataSourceUrl  String?
  sessions       Session[]

  @@unique([seriesId, slug])
}

model Session {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title          String
  kind           String?
  startsAt       DateTime
  endsAt         DateTime
  /** Stable key from external ingest for idempotent upserts (unique per event). */
  externalKey    String?
  dataSourceUrl  String?
  watchOptions   WatchOption[]

  @@unique([eventId, externalKey])
  /** Feed/sign hot path filters on endsAt and orders by startsAt; composite covers both. */
  @@index([endsAt, startsAt])
}

model WatchOption {
  id              String    @id @default(cuid())
  sessionId       String
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  platform        String
  url             String
  requiresPayment Boolean   @default(true)
  notes           String?
  regions         String?
  sourceUrl       String?
  lastVerifiedAt  DateTime?
  /** Soft-hide ingested rows without deleting history */
  archived        Boolean   @default(false)
}

model GoogleAccount {
  id             String   @id @default(cuid())
  googleSub      String   @unique
  email          String
  refreshToken   String
  accessToken    String?
  accessExpiry   DateTime?
  calendarId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/** Single shared calendar created by GOOGLE_* service-account sync; subscribers add this ID in Google Calendar. */
model ServiceCalendarState {
  id          String   @id @default("default")
  calendarId  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
