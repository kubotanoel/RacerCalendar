DATABASE_URL="file:./dev.db"

# REQUIRED on Vercel (Production / Preview): random string, at least 16 characters (spaces trimmed).
# Optional locally during `npm run dev` (insecure fallback is used).
CALENDAR_FEED_SECRET=""

# Min 16 characters in production (e.g. Vercel Production) for signed Google session cookies.
SESSION_SECRET=""

# Server origin for OAuth redirect (matches Google Console “Authorized redirect URIs”).
APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
