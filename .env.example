# PostgreSQL (Prisma Postgres, Neon, Supabase, Railway, …). Paste the pooled connection string Vercel created.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# REQUIRED on Vercel Production (and Preview if you deploy there): ≥16 chars, random.
CALENDAR_FEED_SECRET=""
SESSION_SECRET=""
APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: one shared Google Calendar owned by a service account (public subscribe).
# Enable Calendar API in GCP, create a service account JSON key, then either:
#   GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...single line...}'
# or split:
#   GOOGLE_SERVICE_ACCOUNT_EMAIL="...@....iam.gserviceaccount.com"
#   GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# After deploy, run once (then Vercel Cron keeps it fresh):
#   curl -sS -X POST -H "Authorization: Bearer $CRON_SECRET" "$APP_ORIGIN/api/calendar/service-sync"
# Optional POST JSON: {"freeOnly":false,"categories":[]} — defaults to full schedule / all streams.
CRON_SECRET=""
RACERCALENDAR_SERVICE_SYNC_SECRET=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
